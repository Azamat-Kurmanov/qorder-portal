# Образ рабочего места платформы: статика Vite, собранная внутри образа
# и отданная nginx.
#
# Адресов стенда здесь нет ни одного — ни ARG, ни ENV. Vite подставляет
# import.meta.env на этапе сборки, и запечённый адрес означал бы свой образ
# на каждое окружение: в preprod уезжал бы не тот двоичный артефакт, что
# проверяли на test. Вместо этого настройки приходят при старте контейнера
# (docker-entrypoint/10-app-config.sh) из ConfigMap стенда.

# ---------- стадия 1: сборка статики ----------

# Node той же основной версии, на которой собирают приложение руками:
# расхождение версий тулчейна обнаруживается отказом сборки в самый
# неудобный момент.
FROM node:22-alpine AS build

WORKDIR /app

# Сначала только манифесты: слой с зависимостями переживает правку кода
# и не пересобирается на каждый коммит.
COPY package.json package-lock.json ./

# ci, а не install: ставится ровно то, что записано в package-lock.json,
# и сборка одной и той же ревизии даёт один и тот же результат.
RUN npm ci

COPY . .

# ESLint — до тестов и независимо от SKIP_TESTS: идёт меньше минуты, а ошибка
# правил хуков ломает экран так же, как упавший тест. Предупреждения сборку
# не останавливают. SKIP_LINT=true — аварийный обход для срочной сборки.
ARG SKIP_LINT=false
RUN if [ "$SKIP_LINT" = "true" ]; then echo "ESLint пропущен (SKIP_LINT=true)"; \
    else npm run lint; fi

# Прогон тестов внутри образа, а не отдельным заданием конвейера. Причины:
# (1) проверка не зависит от того, что установлено на раннере GitLab;
# (2) образ, собранный с непрошедшими тестами, не должен существовать вовсе —
#     иначе его кто-нибудь выкатит на стенд;
# (3) `npm run build` проверяет только типы, и сломанный тест иначе дошёл бы
#     до стенда незамеченным.
#
# SKIP_TESTS=true пропускает прогон — так делает конвейер (.gitlab-ci.yml).
# Ручная сборка без аргумента тесты по-прежнему гоняет.
ARG SKIP_TESTS=false
RUN if [ "$SKIP_TESTS" = "true" ]; then echo "Тесты пропущены (SKIP_TESTS=true)"; \
    else npm test -- --maxWorkers=2; fi

# Сборка включает проверку типов (`tsc -b && vite build`): несобираемое
# приложение обязано упасть здесь, а не встретить человека белым экраном.
RUN npm run build

# ---------- стадия 2: итоговый образ ----------

FROM nginx:alpine

# curl нужен ручной проверке пода изнутри (kubectl exec), в nginx:alpine его
# нет. tzdata — иначе время в логах доступа схлопывается в UTC.
RUN apk add --no-cache curl tzdata

# Маршруты приложения: раздача статики, кэширование, прокси на API.
#
# Кладётся в templates/, а не сразу в conf.d/: образ nginx перед запуском
# сервера прогоняет этот каталог через envsubst и сам пишет результат
# в /etc/nginx/conf.d/default.conf. Готовым конфигом файл быть не может —
# адрес API и адрес DNS пода известны только в кластере.
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

# Включает штатный скрипт образа 15-local-resolvers.envsh: он читает
# nameserver из /etc/resolv.conf пода и кладёт его в NGINX_LOCAL_RESOLVERS.
# Так директива resolver получает DNS того кластера, где контейнер реально
# запущен, а не адрес CoreDNS, зашитый когда-то в репозиторий.
ENV NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1

# Какие имена envsubst вправе подставлять в шаблон. Фильтр обязателен:
# без него штатный 20-envsubst-on-templates.sh подставляет ВСЕ переменные
# окружения, а конфиг nginx полон собственных переменных с тем же синтаксисом
# ($host, $request_uri, $api_upstream). Они превратились бы в пустые строки,
# и nginx не стартовал бы вовсе — на стенде это CrashLoopBackOff без
# внятной причины.
ENV NGINX_ENVSUBST_FILTER='^NGINX_(LOCAL_RESOLVERS|API_UPSTREAM|API_DOCS)$'

# Контракт OpenAPI (/v3/api-docs) по умолчанию закрыт (SEC-01); стенд, где
# он нужен `npm run api:pull`, ставит on в своём ConfigMap. Значение по
# умолчанию обязательно: без переменной envsubst оставил бы в конфиге
# ${NGINX_API_DOCS} как есть, и nginx не стартовал бы на неизвестной переменной.
ENV NGINX_API_DOCS=off

# Настройки стенда в статику. Образ nginx исполняет всё из этого каталога
# перед запуском сервера; бит исполнения обязателен — без него файл
# молча пропускается, и приложение осталось бы с пустым config.js.
COPY docker-entrypoint/10-app-config.sh /docker-entrypoint.d/10-app-config.sh
RUN chmod +x /docker-entrypoint.d/10-app-config.sh

# Только результат сборки: ни node_modules, ни исходников в образе нет.
COPY --from=build /app/dist /usr/share/nginx/html

# Отметка о порте; наружу его публикует Service чарта.
EXPOSE 80

# Форма-список: nginx становится процессом 1 и получает SIGTERM напрямую.
CMD ["nginx", "-g", "daemon off;"]
