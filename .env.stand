# Локальная разработка кабинета против стенда test: `npm run dev:stand`.
# Браузер обращается к своему origin, а Vite проксирует API на публичный адрес
# кабинета стенда. Секретов в этом файле нет, он хранится в репозитории.
VITE_DEV_API_TARGET=http://portal-test.q-order.kz
VITE_API_URL=

VITE_KEYCLOAK_URL=http://auth-test.q-order.kz
VITE_KEYCLOAK_REALM=q-order-customers
VITE_KEYCLOAK_CLIENT_ID=q-order-portal
VITE_KEYCLOAK_STAFF_REALM=q-order
VITE_KEYCLOAK_STAFF_CLIENT_ID=q-order-portal-staff
VITE_WEB_URL=http://app-test.q-order.kz
